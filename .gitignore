# .env / secrets — never commit
.env
.env.*
*.key
secrets*
secrets/

# local-only: CLI bridges, per-machine config, anything that is not meant to be
# published. One directory, so "is this safe to push?" is one look. Nothing
# under here is tracked — now or at any point in this repo's history.
local/

# run outputs and the generation cache
runs/
!results/
!results/latest.json
!results/latest.md

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
build/
dist/

# editor / os
.DS_Store
.idea/
.vscode/
*.swp

# agent workspace notes
.workbuddy/
